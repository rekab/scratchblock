{
  "manifest_version": 3,
  "name": "Scratch User Blocker",
  "version": "1.0",
  "description": "Block users on scratch.mit.edu so you never see their comments or projects!",

  "permissions": [
    "storage"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },

  "content_scripts": [
    {
      "matches": ["https://scratch.mit.edu/*"],
      "js": ["content.js"],
      "css": ["blocked.css"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
